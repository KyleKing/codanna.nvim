{
  "$schema": "https://raw.githubusercontent.com/EmmyLuaLs/emmylua-analyzer-rust/refs/heads/main/crates/emmylua_code_analysis/resources/schema.json",
  "runtime": {
    "version": "LuaJIT"
  },
  "workspace": {
    "ignoreDir": [
      "deps",
      ".test-deps",
      ".codanna",
      "test-repos",
      "test/configs"
    ],
    "library": [
      ".test-deps/mini.nvim/lua",
      ".test-deps/telescope.nvim/lua",
      ".test-deps/snacks.nvim/lua"
    ]
  },
  "diagnostics": {
    "globals": [
      "MiniTest",
      "vim"
    ]
  }
}
